---
layout: base.njk
title: "Patricia Rodrigues — Nutricionista em Ibiúna/SP | Saúde da mulher"
description: "Nutrição para a saúde da mulher, em cada fase da vida. Atendimento presencial em Ibiúna/SP ou online por vídeo. Agende sua consulta pelo WhatsApp."
assetBase: ""
home: ""
---

    <!-- Abertura -->
    <section class="abertura" id="inicio" aria-labelledby="titulo-abertura">
      <div class="abertura__interno">
        <div class="abertura__texto">
          <p class="olho">{{ conteudo.abertura.olho }} · CRN {{ site.crn }}</p>
          <h1 id="titulo-abertura">{{ conteudo.abertura.tituloInicio }} <span class="destaque">{{ conteudo.abertura.tituloDestaque }}</span>{{ conteudo.abertura.tituloFim }}</h1>
          <p class="abertura__linha">
            {{ conteudo.abertura.linha }}
          </p>
          <div class="abertura__acoes">
            <a class="botao" href="{{ site.whatsapp }}" target="_blank" rel="noopener">
              {{ conteudo.abertura.botao }}
            </a>
            <a class="link-seta" href="#atendimento">{{ conteudo.abertura.linkSecundario }}</a>
          </div>
          <p class="abertura__local">
            {{ conteudo.abertura.local }}
          </p>
        </div>

        <div class="abertura__visual" aria-hidden="true">
          <span class="abertura__aro"></span>
          <img class="abertura__selo" src="assets/img/logo-selo.webp" alt="" width="480" height="480" loading="eager" decoding="async">
        </div>
      </div>
    </section>

    <!-- Sobre -->
    <section class="secao" id="sobre" aria-labelledby="titulo-sobre">
      <div class="secao__interno">
        <div class="secao__cabecalho">
          <p class="olho">{{ conteudo.sobre.olho }}</p>
          <h2 id="titulo-sobre">{{ conteudo.sobre.titulo }}</h2>
        </div>

        <div class="sobre">
          <div class="sobre__texto">
            {% for paragrafo in conteudo.sobre.paragrafos %}
            <p>{{ paragrafo.texto }}</p>
            {% endfor %}
            <p class="sobre__assinatura">{{ conteudo.sobre.assinatura }}</p>
          </div>

          <div class="cartao">
            <h3>{{ conteudo.sobre.cartaoTitulo }}</h3>
            <ul class="lista-credenciais">
              {% for credencial in conteudo.sobre.credenciais %}
              <li>{{ credencial.item }}</li>
              {% endfor %}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Como funciona -->
    <section class="secao secao--faixa" id="atendimento" aria-labelledby="titulo-atendimento">
      <div class="secao__interno">
        <div class="secao__cabecalho">
          <p class="olho">{{ conteudo.atendimento.olho }}</p>
          <h2 id="titulo-atendimento">{{ conteudo.atendimento.titulo }}</h2>
          <p class="secao__linha">
            {{ conteudo.atendimento.linha }}
          </p>
        </div>

        <ol class="passos">
          {% for passo in conteudo.atendimento.passos %}
          <li class="passo">
            <span class="passo__numero" aria-hidden="true">{{ loop.index }}</span>
            <h3>{{ passo.titulo }}</h3>
            <p>{{ passo.texto }}</p>
          </li>
          {% endfor %}
        </ol>

        <ul class="modalidades">
          {% for modalidade in conteudo.atendimento.modalidades %}
          <li class="modalidade">
            <span class="modalidade__rotulo">{{ modalidade.rotulo }}</span>
            <span class="modalidade__texto">{{ modalidade.texto }}</span>
          </li>
          {% endfor %}
        </ul>

        <h3 class="subtitulo">{{ conteudo.atendimento.servicosTitulo }}</h3>
        <ul class="servicos">
          {% for servico in conteudo.atendimento.servicos %}
          <li class="servico"><h4>{{ servico.titulo }}</h4><p>{{ servico.texto }}</p></li>
          {% endfor %}
        </ul>
      </div>
    </section>

    {% if collections.postsPublicados.length %}
    <!-- Ultimos artigos -->
    <section class="secao" id="artigos" aria-labelledby="titulo-artigos">
      <div class="secao__interno">
        <div class="secao__cabecalho">
          <p class="olho">{{ conteudo.artigos.olho }}</p>
          <h2 id="titulo-artigos">{{ conteudo.artigos.titulo }}</h2>
          <p class="secao__linha">
            {{ conteudo.artigos.linha }}
          </p>
        </div>

        <ul class="artigos">
          {% for post in collections.postsPublicados | limite(3) %}
          <li class="artigo-card">
            <a class="artigo-card__link" href="{{ post.url }}">
              {% if post.data.imagem %}
              <img class="artigo-card__imagem" src="{{ post.data.imagem }}" alt="" width="640" height="360" loading="lazy" decoding="async">
              {% endif %}
              <span class="artigo-card__tipo">{{ post.data.tipo }}</span>
              <h3>{{ post.data.title }}</h3>
              {% if post.data.resumo %}<p>{{ post.data.resumo }}</p>{% endif %}
              <span class="artigo-card__data">{{ post.date | dataBR }}</span>
            </a>
          </li>
          {% endfor %}
        </ul>

        <p class="artigos__mais">
          <a class="link-seta" href="{{ assetBase }}blog/">Ver todos os assuntos</a>
        </p>
      </div>
    </section>
    {% endif %}

    <!-- Contato -->
    <section class="secao" id="contato" aria-labelledby="titulo-contato">
      <div class="secao__interno">
        <div class="secao__cabecalho">
          <p class="olho">{{ conteudo.contato.olho }}</p>
          <h2 id="titulo-contato">{{ conteudo.contato.titulo }}</h2>
        </div>

        <div class="contato">
          <div class="contato__dados">
            <dl class="dados">
              <div class="dados__item">
                <dt>WhatsApp</dt>
                <dd><a href="{{ site.telefoneLink }}" target="_blank" rel="noopener">{{ site.telefone }}</a></dd>
              </div>
              <div class="dados__item">
                <dt>Endereço</dt>
                <dd>
                  <a href="https://www.google.com/maps/search/?api=1&amp;query={{ site.endereco | urlencode }}" target="_blank" rel="noopener">
                    {{ site.endereco }}<br>{{ site.enderecoComplemento }}
                  </a>
                </dd>
              </div>
              <div class="dados__item">
                <dt>Horário</dt>
                <dd>{{ site.horario }}<br>{{ site.horarioObs }}</dd>
              </div>
              <div class="dados__item">
                <dt>Online</dt>
                <dd>{{ site.online }}</dd>
              </div>
              <div class="dados__item">
                <dt>Registro</dt>
                <dd>CRN {{ site.crn }}</dd>
              </div>
            </dl>
          </div>

          <div class="contato__acao">
            <h3>{{ conteudo.contato.acaoTitulo }}</h3>
            <p>{{ conteudo.contato.acaoTexto }}</p>
            <a class="botao botao--largo" href="{{ site.whatsapp }}" target="_blank" rel="noopener">
              {{ conteudo.contato.acaoBotao }}
            </a>
          </div>
        </div>
      </div>
    </section>
